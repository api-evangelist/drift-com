{
  "opencollection": "1.0.0",
  "info": {
    "name": "Drift Accounts Teams API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Drift List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{{base_url}}/teams/org"
          },
          "docs": "Drift List teams"
        },
        {
          "info": {
            "name": "Drift List teams by user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{{base_url}}/teams/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Drift userId"
              }
            ]
          },
          "docs": "Drift List teams by user"
        }
      ]
    }
  ],
  "bundled": true
}