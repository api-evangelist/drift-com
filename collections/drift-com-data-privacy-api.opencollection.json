              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Drift Fetch GDPR data"
        },
        {
          "info": {
            "name": "Drift Delete GDPR data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{{base_url}}/gdpr/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Drift Delete GDPR data"
        }
      ]
    }
  ],
  "bundled": true
}