{
  "opencollection": "1.0.0",
  "info": {
    "name": "Drift Accounts Data Privacy API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data Privacy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
